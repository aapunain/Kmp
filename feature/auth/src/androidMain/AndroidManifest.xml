<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Registers the initializer that captures the Application Context for
      AndroidAuthRepository. Declared in this module's manifest so consuming apps get it
      by manifest merge and do not have to remember anything.
    -->
    <application>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.self.kmp.feature.auth.di.AuthContextInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
