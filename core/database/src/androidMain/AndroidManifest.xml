<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Registers the initializer that captures the Application Context for Room's file
      path. Declared here so consuming apps get it by manifest merge.
    -->
    <application>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.self.kmp.database.internal.DatabaseContextInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
